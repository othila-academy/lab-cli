{
  "name": "@othila-academy/lab",
  "version": "0.10.0",
  "description": "Commande lab d'othila-lab : checks en local contre votre serveur, remontée au formateur, indices, rejeu.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/othila-academy/lab-cli.git"
  },
  "homepage": "https://github.com/othila-academy/lab-cli#readme",
  "bugs": {
    "url": "https://github.com/othila-academy/lab-cli/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "lab": "bin/lab.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./contrat/*": "./contrat/*",
    "./points/*": "./points/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "contrat",
    "points",
    "!src/**/*.test.mjs",
    "!src/tests",
    "!src/test-helpers",
    "!src/fixtures"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "graphql": "16.14.2",
    "graphql-ws": "6.4.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "ws": "8.22.0"
  }
}
